# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API.
# The anon key is safe to expose in the frontend bundle -- Row Level Security
# policies (see supabase/policies.sql) are what actually protect the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
